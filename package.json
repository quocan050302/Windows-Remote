{
  "name": "test-io-agent-studio-root",
  "version": "1.0.0",
  "private": true,
  "description": "Test IO Agent Studio - Windows-MCP + Playwright + Autonomous AI Testing",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "cmd /c start.bat",
    "dev": "npm run dev:desktop",
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "dev:demo": "npm --workspace apps/demo-testing-lab run dev",
    "build": "npm run build --workspaces",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0 || echo 'Lint complete'",
    "test": "npx tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:ts": "npx tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "npx tsx tests/e2e/autonomous_demo.e2e.ts",
    "package:win": "npm --workspace apps/desktop run package:win"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@types/node": "^22.14.0",
    "playwright": "^1.50.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
