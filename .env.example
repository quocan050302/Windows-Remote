# Test IO Agent Studio Environment Configuration Template
# DO NOT COMMIT SENSITIVE KEYS TO SOURCE CONTROL

# Application Environment
NODE_ENV=development
APP_PORT=3000
DEMO_LAB_PORT=4173

# Windows-MCP Configuration
WINDOWS_MCP_PYTHON_PATH=uv
WINDOWS_MCP_DIR=./research/windows-mcp-reference
ANONYMIZED_TELEMETRY=false
WINDOWS_MCP_CONTROL_POLICY=relaxed
WINDOWS_MCP_IDLE_TIMEOUT=10.0

# AI Provider API Keys (Optional if using local Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security and Policy
DEFAULT_EXECUTION_MODE=COPILOT_MODE
DATA_CLASSIFICATION_LEVEL=INTERNAL
ALLOW_AUTO_EXTERNAL_SUBMIT=false
